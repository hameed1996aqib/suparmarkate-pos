COMPOSE_PROJECT_NAME=muhaseb-server-docker
POSTGRES_USER=supermarket
POSTGRES_PASSWORD=supermarket_password
POSTGRES_DB=supermarket_db
JWT_SECRET=replace-with-a-long-random-production-secret
PERMISSION_ENFORCEMENT_MODE=observe
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_IP_ATTEMPTS=30
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
ALLOW_LEGACY_PUBLIC_RECEIPTS=true
RECEIPT_TOKEN_TTL_SECONDS=180
ALLOW_LEGACY_PUBLIC_ATTENDANCE_SCAN=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LAN_API_BASE_URL=http://192.168.100.85:4000
PUBLIC_API_BASE_URL=http://192.168.100.85:4000
MUHASEB_SERVER_LAN_IP=192.168.1.10
MUHASEB_BACKUP_DIR=D:\MuhasebBackups
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-a-random-initial-password
BACKUP_RETENTION_COUNT=7
BACKUP_SCHEDULE_ENABLED=true
BACKUP_INTERVAL_HOURS=24
DHCP_RESERVATION_CONFIRMED=false
UPS_CONFIRMED=false
BACKUP_SECOND_DISK_CONFIRMED=false
